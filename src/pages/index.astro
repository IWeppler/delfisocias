  <div
    class="viewer"
    id="viewer"
    hidden
    role="dialog"
    aria-modal="true"
    aria-label="Pieza ampliada"
  >
    <button class="pill lima-p" type="button" id="close">Cerrar</button>
    <img id="viewer-img" alt="" />
  </div>
</Layout>

<script>
  const viewer = document.getElementById("viewer") as HTMLDivElement;
  const vImg = document.getElementById("viewer-img") as HTMLImageElement;
  const closeBtn = document.getElementById("close") as HTMLButtonElement;
  let last: HTMLElement | null = null;
  document
    .querySelectorAll<HTMLElement>(".piece, .media, [data-zoom], [data-src]")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        const img = btn.querySelector("img");
        last = btn;
        vImg.src = btn.dataset.src || img?.src || "";
        vImg.alt = btn.dataset.src
          ? "Estadísticas del reel en Instagram"
          : img?.alt || "";
        viewer.hidden = false;
        document.documentElement.style.overflow = "hidden";
        closeBtn.focus();
      });
    });
  function closeViewer() {
    viewer.hidden = true;
    document.documentElement.style.overflow = "";
    if (last) last.focus();
  }
  closeBtn.addEventListener("click", closeViewer);
  viewer.addEventListener("click", (e) => {
    if (e.target === viewer) closeViewer();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !viewer.hidden) closeViewer();
  });

  const copyBtn = document.getElementById("copy") as HTMLButtonElement;
  copyBtn.addEventListener("click", () => {
    const mail = document.getElementById("mail") as HTMLElement;
    const done = () => {
      copyBtn.textContent = "Email copiado";
      copyBtn.classList.add("ok");
      setTimeout(() => {
        copyBtn.textContent = "Copiar email";
        copyBtn.classList.remove("ok");
      }, 2000);
    };
    const fallback = () => {
      const r = document.createRange();
      r.selectNodeContents(mail);
      const s = getSelection();
      s?.removeAllRanges();
      s?.addRange(r);
      copyBtn.textContent = "Copialo con Ctrl+C";
    };
    try {
      navigator.clipboard
        .writeText(mail.textContent?.trim() || "")
        .then(done, fallback);
    } catch {
      fallback();
    }
  });

  // Entrada al scrollear: cada bloque sube y aparece una sola vez, escalonado entre hermanos.
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const revealSelector = [
    ".cover-grid > *",
    ".about > *",
    ".center-head",
    ".services > *",
    ".two > *",
    ".pg-head",
    ".brand-grid > *",
    ".posts > *",
    ".pg-content .profile-card",
    ".kpis > *",
    ".cards > *",
    ".lp-intro",
    ".ba > *",
    ".af-row > *",
    ".af-gallery > .profile-card",
    ".client-grid > *",
    ".podcast-work > *",
    ".thanks > *",
  ].join(", ");
  const revealEls = document.querySelectorAll<HTMLElement>(revealSelector);
  revealEls.forEach((el) => {
    const siblings = [...(el.parentElement?.children ?? [])].filter((s) =>
      s.matches(revealSelector),
    );
    el.dataset.reveal = "";
    el.style.setProperty("--d", `${Math.min(siblings.indexOf(el), 5) * 80}ms`);
  });

  // Los KPIs cuentan hasta su valor final (respeta el formato es-AR: 25.389, 5,3%).
  function countUp(el: HTMLElement) {
    const final = el.textContent ?? "";
    const m = final.match(/^([^\d]*)([\d.,]+)(.*)$/);
    if (!m || reduced) return;
    const [, pre, num, post] = m;
    const decimals = num.includes(",") ? num.split(",")[1].length : 0;
    const target = parseFloat(num.replace(/\./g, "").replace(",", "."));
    const fmt = new Intl.NumberFormat("es-AR", {
      minimumFractionDigits: decimals,
      maximumFractionDigits: decimals,
    });
    const start = performance.now();
    const dur = 1100;
    const tick = (now: number) => {
      const t = Math.min((now - start) / dur, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = t < 1 ? pre + fmt.format(target * eased) + post : final;
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        el.classList.add("is-in");
        if (el.matches(".kpi")) countUp(el.querySelector("b") as HTMLElement);
        revealObserver.unobserve(el);
      });
    },
    { rootMargin: "0px 0px -8% 0px", threshold: 0.15 },
  );
  revealEls.forEach((el) => revealObserver.observe(el));

  // Nav: marca la sección visible. Las páginas sin enlace propio heredan la anterior.
  const navLinks = document.querySelectorAll<HTMLAnchorElement>(".bar nav a");
  const navFor: Record<string, string> = {
    "sobre-mi": "#sobre-mi",
    servicios: "#servicios",
    pergoagro: "#pergoagro",
    "ley-primera": "#pergoagro",
    "autoservicio-familiar": "#pergoagro",
    contacto: "#contacto",
  };
  const pages = [...document.querySelectorAll<HTMLElement>("main > .page")];
  function updateNav() {
    const line = innerHeight * 0.4;
    let current = "";
    for (const page of pages) {
      if (page.getBoundingClientRect().top > line) break;
      if (page.id) current = navFor[page.id] ?? "";
    }
    navLinks.forEach((a) => {
      if (a.getAttribute("href") === current) a.setAttribute("aria-current", "location");
      else a.removeAttribute("aria-current");
    });
  }
  let navQueued = false;
  addEventListener(
    "scroll",
    () => {
      if (navQueued) return;
      navQueued = true;
      requestAnimationFrame(() => {
        navQueued = false;
        updateNav();
      });
    },
    { passive: true },
  );
  updateNav();

  // Parallax de stickers: cada uno se mueve según data-parallax (más alto = más rápido),
  // relativo al centro de su página. Solo se calculan las páginas visibles.
  const stickers = [...document.querySelectorAll<HTMLElement>("[data-parallax]")];
  if (!reduced && stickers.length) {
    const visible = new Set<HTMLElement>();
    const items = stickers.map((el) => ({
      el,
      depth: parseFloat(el.dataset.parallax ?? "0"),
      page: el.closest<HTMLElement>(".page") as HTMLElement,
    }));
    const pageObserver = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) visible.add(e.target as HTMLElement);
        else visible.delete(e.target as HTMLElement);
      });
      updateParallax();
    });
    new Set(items.map((i) => i.page)).forEach((p) => pageObserver.observe(p));

    function updateParallax() {
      const mid = innerHeight / 2;
      // En pantallas chicas las páginas son altas: menos recorrido para no tapar el texto.
      const narrow = innerWidth < 760;
      for (const { el, depth, page } of items) {
        if (!visible.has(page)) continue;
        const max = !narrow ? 90 : el.matches(".sticker") ? 10 : 40;
        const r = page.getBoundingClientRect();
        const offset = (r.top + r.height / 2 - mid) * depth * (narrow ? 0.5 : 1);
        el.style.translate = `0 ${Math.max(-max, Math.min(max, offset)).toFixed(1)}px`;
      }
    }
    let parallaxQueued = false;
    addEventListener(
      "scroll",
      () => {
        if (parallaxQueued) return;
        parallaxQueued = true;
        requestAnimationFrame(() => {
          parallaxQueued = false;
          updateParallax();
        });
      },
      { passive: true },
    );
    addEventListener("resize", updateParallax, { passive: true });
  }
</script>
