---
import Layout from "../layouts/Layout.astro";

// Email de contacto que se muestra y copia en la sección #contacto.
const email = "delfisocp5@gmail.com";
---

<Layout>
  <header class="bar">
    <div class="in">
      <a href="#inicio" aria-label="Inicio"
        ><img src="/brand/logo-claro.svg" alt="DMAS" /></a
      >
      <nav aria-label="Secciones">
        <a href="#sobre-mi">Sobre mí</a>
        <a href="#servicios">Servicios</a>
        <a href="#proyectos">Proyectos</a>
        <a class="cta" href="#contacto">Trabajemos juntos</a>
      </nav>
    </div>
  </header>

  <main>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="ig-like" viewBox="0 0 24 24"
        ><path
          d="M12 20.5s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.7c0 5.6-7.5 10.2-7.5 10.2Z"
        ></path></symbol
      >
      <symbol id="ig-comment" viewBox="0 0 24 24"
        ><path
          d="M20.5 11.6a8.5 8.5 0 1 1-3.4-6.8 8.4 8.4 0 0 1 3.4 6.8Zm0 0 .8 8.2-5-2.3"
        ></path></symbol
      >
      <symbol id="ig-repost" viewBox="0 0 24 24"
        ><path
          d="M17 3.5 20.5 7 17 10.5M20.5 7H8a4 4 0 0 0-4 4v1M7 20.5 3.5 17 7 13.5M3.5 17H16a4 4 0 0 0 4-4v-1"
        ></path></symbol
      >
      <symbol id="ig-share" viewBox="0 0 24 24"
        ><path d="M21.5 3.5 10.6 13.4M21.5 3.5 14.6 21l-4-7.6-7.6-4 18.5-5.9Z"
        ></path></symbol
      >
      <symbol id="ig-save" viewBox="0 0 24 24"
        ><path
          d="M19 21 12 15.3 5 21V4.5A1.5 1.5 0 0 1 6.5 3h11A1.5 1.5 0 0 1 19 4.5Z"
        ></path></symbol
      >
    </svg>
    <!-- 1 · Portada -->
    <section class="page grid-bg cover" id="inicio">
      <div class="in">
        <div class="cover-grid">
          <div>
            <p class="hash">#DeMásCanchero</p>
            <h1 style="margin-top:18px">
              <span>Hola,</span><span
                >soy <span class="hl"><i></i>Delfina<i></i></span></span
              >
            </h1>
            <p class="roles">
              Social Media Manager<br />&amp; Community Manager
            </p>
            <div class="row">
              <a class="pill" href="#contacto">Trabajemos juntos!</a>
              <span class="handle">@hello.dmas</span>
            </div>
          </div>
          <div class="photo">
            <div class="frame">
              <img class="ph" src="/brand/logo-claro.svg" alt="DMAS" />
            </div>
            <img class="s1" data-parallax="0.18" src="/brand/st-carita.svg" alt="" />
            <img class="s2" data-parallax="0.3" src="/brand/st-corazon.svg" alt="" />
            <img class="s3" data-parallax="0.1" src="/brand/st-rayo.svg" alt="" />
          </div>
        </div>
      </div>
    </section>

    <!-- 2 · Sobre mí -->
    <section class="page dark grid-bg" id="sobre-mi">
      <img
        class="sticker"
        data-parallax="0.22"
        src="/brand/st-estrella.svg"
        alt=""
        style="right:6%;top:10%"
      />
      <img
        class="sticker"
        data-parallax="0.4"
        src="/brand/st-internet.svg"
        alt=""
        style="right:14%;bottom:12%;width:clamp(60px,7vw,110px)"
      />
      <div class="in">
        <div class="about">
          <div>
            <p class="eyebrow muted">Sobre mí</p>
            <h2 class="title" style="margin-top:14px">
              Tu marca tiene mucho para decir. Yo sé <span class="hl v"
                ><i></i>cómo contarlo.<i></i></span
              >
            </h2>
          </div>
          <div class="txt">
            <p>
              Soy Delfina Socias, Social Media Manager y Community Manager. Con
              DMAS creo contenido que construye, conecta y transforma.
            </p>
            <p>
              Combino estrategia, creatividad y análisis para desarrollar marcas con una presencia sólida, coherente y orientada a resultados. Me gusta el marketing digital y disfruto transformar ideas en contenido que conecta, comunica y genera valor.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 · Servicios -->
    <section class="page grid-bg" id="servicios">
      <div class="in">
        <div class="center-head">
          <span class="tag-head">Mis servicios</span>
          <p class="lead muted">
            Estrategia, identidad y gestión para que tu marca crezca en redes.
          </p>
        </div>
        <div class="services">
          <div class="svc">
            <img src="/brand/ic-corazon.svg" alt="" /><h3>Community Manager</h3>
            <p>Gestión de la comunidad, interacción con la audiencia y fortalecimiento del vínculo.</p>
          </div>
          <div class="svc">
            <img src="/brand/ic-hash.svg" alt="" /><h3>Gestión de RR.SS</h3>
            <p>Estrategias personalizadas para posicionar tu marca y alcanzar objetivos.</p>
          </div>
          <div class="svc">
            <img src="/brand/ic-flor.svg" alt="" /><h3>Content Creation</h3>
            <p>Videos, posts y contenido visual atractivo para las marcas.</p>
          </div>
          <div class="svc">
            <img src="/brand/ic-flecha.svg" alt="" /><h3>Métricas y reportes</h3>
            <p>Análisis mensual con lo que funcionó y los próximos pasos.</p>
          </div>
        </div>      </div>
    </section>

    <!-- 5 · Skills y herramientas -->
    <section class="page grid-bg">
      <div class="in">
        <div class="two">
          <div>
            <span class="tag-head" style="background:var(--negro)"
              >Mis skills</span
            >
            <ul class="checks">
              <li>Estrategia y planificación de contenido</li>
              <li>Copywriting y tono de voz</li>
              <li>Gestión de comunidad y atención por DM</li>
              <li>Guiones para reels y TikTok</li>
              <li>Diseño de piezas y grilla de feed</li>
              <li>Análisis de métricas y reportes</li>
            </ul>
          </div>
          <div>
            <span class="tag-head">Las herramientas que uso</span>
            <div class="tools">
              <span class="tool"
